{
  "name": "valis-fizzbuzz-desktop",
  "private": true,
  "version": "1.13.0",
  "description": "Local Windows creature evolution desktop app driven by FizzBuzz energy and immutable DNA",
  "main": "src/desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "build:assets": "node tools/build-assets.cjs",
    "check:assets": "node tools/build-assets.cjs --check",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:motion": "node tests/browser-motion.cjs",
    "test:desktop": "node tests/electron-smoke.cjs",
    "package:windows": "node tools/package-windows.cjs",
    "test:performance": "node tests/browser-performance.cjs",
    "test:art": "node tests/browser-art.cjs",
    "test:interaction": "node tests/browser-interaction.cjs",
    "test:finish": "node tests/browser-finish.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/get": "5.0.0",
    "@electron/asar": "4.3.1",
    "electron": "44.7.2",
    "playwright": "1.56.1",
    "pngjs": "7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
